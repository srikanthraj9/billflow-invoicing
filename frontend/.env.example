# BillFlow Frontend Environment Configuration
# Note: Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# NEVER place backend secrets, JWT keys, or private database credentials here.

# In Render production, set this to your backend service URL + /api (e.g., https://<your-backend>.onrender.com/api)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
