# Database Configuration (PostgreSQL / Supabase Transaction Pooler)
DATABASE_URL="postgresql+psycopg://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres"
DIRECT_URL="postgresql+psycopg://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres"

# JWT Authentication
JWT_SECRET_KEY="replace-with-a-secure-random-64-character-hex-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Supabase Storage Configuration
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="billflow-logos"

# CORS Configuration (Production / Render Frontend URL)
FRONTEND_URL="https://<your-frontend>.onrender.com"
